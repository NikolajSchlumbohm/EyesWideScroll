id 142-145 : text
id 146 : text politik
id 147-150 : text meme
id 151-153 : text meme (politik)
"""

result = {}

for line in data.strip().splitlines():
    # Extract IDs and tags
    ids_part, tags_part = line.split(":")
    ids_part = ids_part.replace("id", "").strip()
    tags_part = tags_part.strip()

    # Expand ranges or single ids
    if "-" in ids_part:
        start, end = map(int, ids_part.split("-"))
        ids = range(start, end + 1)
    else:
        ids = [int(ids_part)]

    # Normalize tags: remove parentheses but keep content
    tags_clean = re.sub(r"[()]", "", tags_part)
    tags = tags_clean.split()

    # Assign tags to each id
    for i in ids:
        result[i] = tags

# Example output
print(result)
