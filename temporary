id 87 : person (text)
id 88 : person text politik
id 89-91 : person politik
id 92 : person politik (text)
id 93-98 : person politik
id 99-100 : person politik text
id 101 : person politik
id 102 : person politik (text)
id 103-105 : politik person 
id 106 : meme text (politik)
id 107 : politik person text meme
id 108 : meme text
id 109 : meme text politik
id 110-115 : meme text
